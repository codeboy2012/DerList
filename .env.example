# ==========================================
# DerList
# Environment Configuration
# Copy this file to .env.local or .env
# ==========================================

# ==========================================
# Application
# ==========================================

NEXT_PUBLIC_APP_NAME=DerList
NEXT_PUBLIC_APP_URL=http://localhost:3000

NODE_ENV=development

# ==========================================
# Database
# ==========================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/derlist

# ==========================================
# Authentication
# ==========================================

# Generate with:
# openssl rand -base64 32
AUTH_SECRET=

# Session length in days
AUTH_SESSION_DAYS=30

# ==========================================
# Email (Future)
# ==========================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ==========================================
# Storage (Future)
# ==========================================

UPLOAD_DIR=uploads

# ==========================================
# Provider System
# ==========================================

# AES-256-GCM encryption key for provider API keys and configurations
# Generate with: npm run generate-encryption-key
# Keep this key secure and use the same key across all instances
PROVIDER_ENCRYPTION_KEY=

# Legacy AI configuration (deprecated - will be migrated to provider system)
OPENAI_API_KEY=

# Puter.js — powers Shopping AI + Product Getter (deprecated)
# Get your token at https://puter.com/dashboard
PUTER_AUTH_TOKEN=

# ==========================================
# Feature Flags
# ==========================================

NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=false

# ==========================================
# Rate Limiting (Future)
# ==========================================

RATE_LIMIT_ENABLED=true

# ==========================================
# Logging
# ==========================================

LOG_LEVEL=info