# ==========================================
# DerList — Environment Configuration
# ==========================================
# Copy this file to .env and fill in values.
# Lines marked [REQUIRED] must be set for the app to start.
# Lines marked [OPTIONAL] have sensible defaults.
# ==========================================

# ==========================================
# Database [REQUIRED for Docker]
# ==========================================

# PostgreSQL credentials (used by Docker Compose to create the database)
POSTGRES_USER=derlist
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
POSTGRES_DB=derlist

# Full connection string (auto-constructed in Docker Compose, set manually for non-Docker)
# For Docker: leave commented — docker-compose.yml builds it from the above vars.
# For non-Docker:
# DATABASE_URL=postgresql://derlist:your_password@localhost:5432/derlist

# ==========================================
# Application [OPTIONAL]
# ==========================================

# Public-facing URL of your DerList instance
# Used for OAuth callbacks, share links, and metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Port the app container exposes on the host
APP_PORT=3000

# ==========================================
# Authentication [REQUIRED]
# ==========================================

# Secret key for signing session tokens
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Session length in days (default: 30)
# AUTH_SESSION_DAYS=30

# ==========================================
# OAuth Providers [OPTIONAL]
# ==========================================
# At least one OAuth provider OR email/password is needed to log in.
# Leave blank to disable a provider.

# GitHub OAuth
# Create at: https://github.com/settings/developers
# Callback URL: {NEXT_PUBLIC_APP_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
# Create at: https://console.cloud.google.com/apis/credentials
# Callback URL: {NEXT_PUBLIC_APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==========================================
# Admin Account (First Run) [RECOMMENDED]
# ==========================================
# These are used ONLY on first startup to create the owner account.
# If not set, you must create the first user manually.
# The seed is idempotent — it won't create duplicates on restart.

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Admin

# ==========================================
# Provider Encryption [OPTIONAL]
# ==========================================
# AES-256-GCM encryption key for API provider configurations
# Generate with: node scripts/generate-encryption-key.js
# Required if you use AI/shopping/price provider integrations.
PROVIDER_ENCRYPTION_KEY=

# ==========================================
# Feature Flags [OPTIONAL]
# ==========================================

NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=false

# ==========================================
# Logging [OPTIONAL]
# ==========================================

LOG_LEVEL=info

# ==========================================
# Caddy / Domain (only if using the caddy profile)
# ==========================================
# Set your domain for automatic HTTPS via Let's Encrypt
# DOMAIN=derlist.example.com
