# ─────────────────────────────────────────────────────────────────────────────
# DerList — Environment Configuration
#
# Quick start:
#   cp .env.example .env
#   # Edit .env and fill in your secrets
#   docker compose up -d
#
# Everything else is automatic — migrations, seeding, HTTPS certificates.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_NAME=DerList

# Your public-facing URL (used for OAuth callbacks, link generation, etc.)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ─── Domain (used by Caddy for automatic HTTPS) ──────────────────────────────

# Set to your domain for automatic HTTPS via Let's Encrypt.
# Use "localhost" for local testing (Caddy will use a self-signed cert).
DOMAIN=your-domain.com

# ─── Database ────────────────────────────────────────────────────────────────

# PostgreSQL credentials — Docker Compose creates the database automatically.
# DATABASE_URL is constructed from these values; do NOT set it manually.
POSTGRES_USER=derlist
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=derlist

# Only needed for local development outside Docker:
# DATABASE_URL=postgresql://derlist:password@localhost:5432/derlist

# ─── Authentication (required) ───────────────────────────────────────────────

# Session signing key — generate with:
#   openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# Session length in days (default: 30)
AUTH_SESSION_DAYS=30

# ─── Provider Encryption (required) ──────────────────────────────────────────

# AES-256-GCM key used to encrypt stored API keys.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PROVIDER_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_NODE

# ─── Initial Admin Account (required for first-time setup) ───────────────────

# These are used once — on first startup when the users table is empty.
# After the admin account is created these values are no longer used.
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Administrator

# ─── OAuth Providers (at least one recommended) ──────────────────────────────

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Optional: Port Override ─────────────────────────────────────────────────

# Change the host port the app binds to (default: 3000).
# Caddy handles 80/443 regardless of this setting.
# APP_PORT=3000

# ─── Optional: Email (future) ────────────────────────────────────────────────

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@your-domain.com

# ─── Optional: Storage ───────────────────────────────────────────────────────

UPLOAD_DIR=uploads

# ─── Optional: Redis (uncomment redis in docker-compose.yml first) ────────────

# REDIS_URL=redis://redis:6379

# ─── Optional: Meilisearch (uncomment in docker-compose.yml first) ────────────

# MEILI_MASTER_KEY=changeme
# MEILI_URL=http://meilisearch:7700

# ─── Feature Flags ───────────────────────────────────────────────────────────

NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=false

# ─── Logging ─────────────────────────────────────────────────────────────────

LOG_LEVEL=info
