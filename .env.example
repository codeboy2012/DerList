# ─────────────────────────────────────────────────────────────────────────────
# DerList — Environment Configuration
#
# Copy this file to .env and fill in the required values.
#
# Docker deployment:
#   cp .env.example .env
#   # edit .env with your secrets
#   docker compose up -d
#
# That's it. Everything else is automatic.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_NAME=DerList
NEXT_PUBLIC_APP_URL=https://your-domain.com

NODE_ENV=production

# ─── Domain (used by Caddy for automatic HTTPS) ──────────────────────────────

# Set to your domain for automatic HTTPS via Let's Encrypt.
# Use "localhost" for local development (Caddy will use self-signed cert).
DOMAIN=your-domain.com

# ─── Database (Docker handles this automatically) ────────────────────────────

# These are used by docker-compose to create PostgreSQL and build the connection URL.
# You do NOT need to set DATABASE_URL — it's constructed automatically.
POSTGRES_USER=derlist
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=derlist

# Only needed for non-Docker local development:
# DATABASE_URL=postgresql://derlist:password@localhost:5432/derlist

# ─── Authentication (required) ───────────────────────────────────────────────

# Session encryption key. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# Session length in days
AUTH_SESSION_DAYS=30

# ─── OAuth Providers (at least one recommended) ──────────────────────────────

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Provider System ─────────────────────────────────────────────────────────

# AES-256-GCM encryption key for provider API keys.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PROVIDER_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_NODE

# ─── Optional: Port Override ─────────────────────────────────────────────────

# Change the host port the app binds to (default: 3000).
# Caddy handles 80/443 regardless of this setting.
# APP_PORT=3000

# ─── Optional: Email (future) ────────────────────────────────────────────────

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@your-domain.com

# ─── Optional: Storage ───────────────────────────────────────────────────────

UPLOAD_DIR=uploads

# ─── Optional: Redis (uncomment redis in docker-compose.yml first) ────────────

# REDIS_URL=redis://redis:6379

# ─── Optional: Meilisearch (uncomment in docker-compose.yml first) ────────────

# MEILI_MASTER_KEY=changeme
# MEILI_URL=http://meilisearch:7700

# ─── Feature Flags ───────────────────────────────────────────────────────────

NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=false

# ─── Logging ─────────────────────────────────────────────────────────────────

LOG_LEVEL=info
