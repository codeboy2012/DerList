  enabled Boolean @default(true)

  /// Priority order (1 = highest priority, used for failover)
  priority Int @default(1)

  /// AES-256-GCM encrypted configuration JSON (API keys, endpoints, etc.)
  encryptedConfig String

  /// Initialization vector for AES-GCM encryption
  configIv String

  /// Authentication tag for AES-GCM encryption
  configAuthTag String

  /// Rate limiting configuration as JSON
  rateLimit Json?

  /// Timeout configuration in milliseconds
  timeout Int @default(30000)

  /// Retry configuration as JSON
  retries Json?

  /// Provider-specific metadata as JSON
  metadata Json?

