// ─────────────────────────────────────────────────────────────────────────────
// DerList — Database Schema (Phase 1: Authentication & Waitlist Foundation)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

/// System roles ordered by privilege level.
/// OWNER: Highest permission level — single account that controls the instance.
/// ADMIN: Can manage users, send invitations, approve waitlist entries.
/// USER: Standard authenticated user.
enum Role {
  OWNER
  ADMIN
  USER
}

// ─────────────────────────────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────────────────────────────

/// Represents an authenticated DerList user.
/// Users cannot self-register — accounts are created by administrators
/// or accepted through the invitation flow.
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Unique email address used for login and communication.
  email String @unique

  /// Unique public username (URL-safe, lowercase).
  username String @unique

  /// User-facing display name (can contain spaces, emoji, etc.).
  displayName String

  /// Argon2/bcrypt hash of the user's password.
  passwordHash String

  /// URL to the user's avatar image. Nullable — not every user uploads one.
  avatarUrl String?

  /// Permission level for this user.
  role Role @default(USER)

  /// Whether the user has verified their email address.
  emailVerified Boolean @default(false)

  /// Timestamp of the user's most recent successful login. Nullable until first login.
  lastLoginAt DateTime?

  /// Soft-disable flag. Disabled users cannot authenticate.
  disabled Boolean @default(false)

  /// DEPRECATED: Legacy AI provider fields - replaced by dedicated provider tables
  /// These fields are kept for migration compatibility and will be removed after migration
  aiProviderId String?
  aiProviderConfig Json?

  // ── Relations ──

  /// Invitations this user has sent (as an admin).
  invitations Invitation[]

  /// Active sessions for this user.
  sessions Session[]

  /// OAuth linked accounts (GitHub, Google, etc.).
  oauthAccounts OAuthAccount[]

  /// Wishlists owned by this user.
  wishlists Wishlist[]

  /// Wishlist memberships (collaborative access).
  wishlistMemberships WishlistMember[]

  /// Uploaded media files.
  uploads Media[]

  /// AI provider configurations for this user.
  aiProviders UserAIProvider[]

  /// Shopping search provider configurations for this user.
  shoppingProviders UserShoppingProvider[]

  /// Price tracking provider configurations for this user.
  priceProviders UserPriceProvider[]

  /// Vision provider configurations for this user.
  visionProviders UserVisionProvider[]

  /// Unified provider configurations (replaces separate provider tables)
  providerConfigurations ProviderConfiguration[]

  /// Provider usage analytics.
  providerUsage ProviderUsage[]

  /// Price alerts created by this user.
  priceAlerts ProviderPriceAlert[]

  /// Shopping assistant conversations.
  shoppingConversations ShoppingConversation[]

  @@index([email])
  @@index([username])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Provider Management Enums
// ─────────────────────────────────────────────────────────────────────────────

/// Provider categories for type-safe provider management
enum ProviderCategory {
  AI
  SHOPPING_SEARCH
  PRICE
  VISION
}

/// Provider status for health monitoring
enum ProviderStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
  UNKNOWN
}

/// Provider usage event types for analytics
enum ProviderUsageType {
  CHAT
  PRODUCT_IDENTIFICATION
  PRODUCT_NORMALIZATION
  RECOMMENDATION
  DATA_EXTRACTION
  PRODUCT_SEARCH
  PRODUCT_DETAILS
  PRODUCT_OFFERS
  IMAGE_SEARCH
  PRODUCT_REVIEWS
  CURRENT_PRICE
  PRICE_HISTORY
  PRICE_ALERTS
  PRICE_MONITORING
  PRICE_COMPARISON
  PRICE_VERIFICATION
  PRICE_DROPS
  VISION_ANALYSIS
  OCR
  BARCODE_SCAN
}

// ─────────────────────────────────────────────────────────────────────────────
// Unified Provider Configuration
// ─────────────────────────────────────────────────────────────────────────────

/// Unified provider configuration table for all provider types
/// This replaces the separate UserAIProvider, UserShoppingProvider, etc. tables
model ProviderConfiguration {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The user who owns this provider configuration
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// Provider category (AI, SHOPPING_SEARCH, PRICE, VISION)
  category ProviderCategory

  /// Provider identifier (e.g., 'openai', 'anthropic', 'serpapi', 'keepa')
  providerId String

  /// Display name for this provider instance
  name String

  /// Whether this provider is enabled
  enabled Boolean @default(true)

  /// Priority order (1 = highest priority, used for failover)
  priority Int @default(1)

  /// AES-256-GCM encrypted configuration JSON (API keys, endpoints, etc.)
  encryptedConfig String

  /// Initialization vector for AES-GCM encryption
  configIv String

  /// Authentication tag for AES-GCM encryption
  configAuthTag String

  /// Rate limiting configuration as JSON
  rateLimit Json?

  /// Timeout configuration in milliseconds
  timeout Int @default(30000)

  /// Retry configuration as JSON
  retries Json?

  /// Provider-specific metadata as JSON
  metadata Json?

  /// Whether this is the default provider for this category and user
  isDefault Boolean @default(false)

  /// Last health check timestamp
  lastHealthCheck DateTime?

  /// Last known provider status
  lastStatus ProviderStatus @default(UNKNOWN)

  /// Last successful request timestamp
  lastSuccessAt DateTime?

  /// Last error timestamp
  lastErrorAt DateTime?

  /// Last error message
  lastError String?

  /// Usage analytics relation
  usage ProviderUsage[]

  @@unique([userId, category, providerId])
  @@index([userId])
  @@index([userId, category])
  @@index([userId, enabled])
  @@index([userId, category, priority])
  @@index([providerId])
  @@index([category])
  @@index([lastStatus])
  @@map("provider_configurations")
}

